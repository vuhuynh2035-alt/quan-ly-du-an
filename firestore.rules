rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userOrgIds() {
      return userDoc().keys().hasAny(['orgIds']) && userDoc().orgIds is list
        ? userDoc().orgIds
        : (userDoc().keys().hasAny(['orgId']) ? [userDoc().orgId] : []);
    }

    function sameOrg(orgId) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && orgId in userOrgIds();
    }

    function otherUserOrgIds(uid) {
      let d = get(/databases/$(database)/documents/users/$(uid)).data;
      return d.keys().hasAny(['orgIds']) && d.orgIds is list
        ? d.orgIds
        : (d.keys().hasAny(['orgId']) ? [d.orgId] : []);
    }

    function isDirector() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().role == 'director';
    }

    function isDieuHanh() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().empGroup == 'Điều hành';
    }

    function isHanhChinh() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().empGroup == 'Hành chính';
    }

    function isGiamSat() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (userDoc().empGroup == 'Giám sát' || userDoc().empGroup == 'Quản lý');
    }

    function isChiHuyTruong() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().empGroup == 'Chỉ huy trưởng';
    }

    /** Đọc đơn nghỉ phép chung công ty: GD / DH / GS / HC / CHT */
    function canReadCompanyLeave() {
      return isDirector() || isDieuHanh() || isGiamSat() || isHanhChinh() || isChiHuyTruong();
    }

    function canOperateWorkspace() {
      return isDirector() || isDieuHanh();
    }

    function isBroadcastMsg(data) {
      return !('type' in data) || data.type == 'broadcast';
    }

    function isDmParticipant(data) {
      return data.type == 'dm'
        && data.participants is list
        && request.auth.uid in data.participants;
    }

    function isLeaveParticipant(data) {
      return data.type == 'leave'
        && data.participants is list
        && request.auth.uid in data.participants;
    }

    function validMsgText(data) {
      return data.text is string
        && data.text.size() > 0
        && data.text.size() <= 2000;
    }

    function participantOk(orgId, uid) {
      return uid is string
        && uid.size() > 0
        && exists(/databases/$(database)/documents/users/$(uid))
        && (
          orgId in otherUserOrgIds(uid)
          || get(/databases/$(database)/documents/users/$(uid)).data.role == 'director'
        );
    }

    function validLeaveParticipants(orgId, parts) {
      return parts is list
        && parts.size() >= 2
        && parts.size() <= 8
        && request.auth.uid in parts
        && participantOk(orgId, parts[0])
        && participantOk(orgId, parts[1])
        && (parts.size() < 3 || participantOk(orgId, parts[2]))
        && (parts.size() < 4 || participantOk(orgId, parts[3]))
        && (parts.size() < 5 || participantOk(orgId, parts[4]))
        && (parts.size() < 6 || participantOk(orgId, parts[5]))
        && (parts.size() < 7 || participantOk(orgId, parts[6]))
        && (parts.size() < 8 || participantOk(orgId, parts[7]));
    }

    function validDmCreate(orgId, data) {
      return data.type == 'dm'
        && data.uid == request.auth.uid
        && data.toUid is string
        && data.toUid.size() > 0
        && data.toUid != request.auth.uid
        && data.threadId is string
        && data.threadId.size() > 0
        && data.participants is list
        && data.participants.size() == 2
        && request.auth.uid in data.participants
        && data.toUid in data.participants
        && exists(/databases/$(database)/documents/users/$(data.toUid))
        && orgId in otherUserOrgIds(data.toUid);
    }

    function validLeaveCreate(orgId, data) {
      return data.type == 'leave'
        && data.uid == request.auth.uid
        && data.leaveReqId is string
        && data.leaveReqId.size() > 0
        && data.leaveReqId.size() <= 80
        && data.threadId == ('leave:' + data.leaveReqId)
        && validLeaveParticipants(orgId, data.participants)
        && (!('kind' in data)
            || data.kind in ['leave_req', 'leave_decision', 'leave_chat']);
    }

    function validBroadcastCreate(data) {
      return data.type == 'broadcast'
        && data.uid == request.auth.uid
        && canOperateWorkspace();
    }

    function validMsgReceiptUpdate() {
      let diff = request.resource.data.diff(resource.data).affectedKeys();
      return (resource.data.type == 'dm' || resource.data.type == 'leave')
        && (isDmParticipant(resource.data) || isLeaveParticipant(resource.data))
        && request.auth.uid != resource.data.uid
        && diff.hasOnly(['deliveredAt', 'readAt'])
        && (!diff.hasAny(['deliveredAt']) || request.resource.data.deliveredAt is string)
        && (!diff.hasAny(['readAt']) || request.resource.data.readAt is string)
        && request.resource.data.text == resource.data.text
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.type == resource.data.type
        && request.resource.data.threadId == resource.data.threadId
        && request.resource.data.participants == resource.data.participants;
    }

    function validProfileAge(age) {
      return age == null || (age is int && age >= 1 && age <= 150);
    }

    function validSelfProfileUpdate() {
      let diff = request.resource.data.diff(resource.data).affectedKeys();
      return diff.hasOnly(['displayName', 'age', 'updatedAt', 'activeOrgId', 'orgId'])
        && (!diff.hasAny(['displayName'])
            || (request.resource.data.displayName is string
                && request.resource.data.displayName.size() <= 100))
        && (!diff.hasAny(['age']) || validProfileAge(request.resource.data.age))
        && (!diff.hasAny(['activeOrgId'])
            || (request.resource.data.activeOrgId is string
                && request.resource.data.activeOrgId in userOrgIds()))
        && (!diff.hasAny(['orgId'])
            || (request.resource.data.orgId is string
                && request.resource.data.orgId in userOrgIds()))
        && request.resource.data.role == resource.data.role
        && request.resource.data.username == resource.data.username
        && request.resource.data.empId == resource.data.empId;
    }

    function validSelfFcmUpdate() {
      return request.resource.data.role == resource.data.role
        && request.resource.data.username == resource.data.username
        && request.resource.data.orgId == resource.data.orgId
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['fcmToken', 'empId', 'empGroup', 'updatedAt', 'activeOrgId', 'orgIds']);
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId
        && (!request.resource.data.keys().hasAny(['role'])
            || request.resource.data.role == 'employee');
      allow update: if signedIn() && request.auth.uid == userId
        && (validSelfProfileUpdate() || validSelfFcmUpdate());
    }

    match /company/{companyId}/employees/{empId} {
      allow read: if signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
      allow create, update, delete: if canOperateWorkspace();
    }

    // Khách hàng dùng chung cả 2 đội (Công trình tỉnh / HCM)
    match /company/{companyId}/customers/{custId} {
      allow read: if signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
      allow create, update, delete: if canOperateWorkspace();
    }

    match /workspaces/{orgId}/data/{docId} {
      allow read: if sameOrg(orgId);
      allow write: if sameOrg(orgId) && canOperateWorkspace();
    }

    match /workspaces/{orgId}/messages/{msgId} {
      // Oversight đọc được tin nghỉ phép ở cả 2 đội
      allow read: if (sameOrg(orgId) || (canReadCompanyLeave() && isLeaveParticipant(resource.data)))
        && (isBroadcastMsg(resource.data)
            || isDmParticipant(resource.data)
            || isLeaveParticipant(resource.data));
      allow create: if validMsgText(request.resource.data)
        && (
          (sameOrg(orgId)
            && (validDmCreate(orgId, request.resource.data)
                || validBroadcastCreate(request.resource.data)
                || validLeaveCreate(orgId, request.resource.data)))
          || (isDirector() && validLeaveCreate(orgId, request.resource.data))
        );
      allow update: if (sameOrg(orgId) || (canReadCompanyLeave() && isLeaveParticipant(resource.data)))
        && validMsgReceiptUpdate();
      allow delete: if false;
    }

    match /workspaces/{orgId}/reports/{reportId} {
      allow read: if sameOrg(orgId);
      allow create, update, delete: if false;
    }

    match /workspaces/{orgId}/attendance/{recordId} {
      allow read: if sameOrg(orgId);
      allow create, update, delete: if false;
    }

    match /workspaces/{orgId}/arrivals/{recordId} {
      allow read: if sameOrg(orgId);
      allow create, update, delete: if false;
    }

    // Đơn xin nghỉ phép: chung cả 2 đội với giám đốc; NV tạo (pending), GD duyệt/từ chối
    match /workspaces/{orgId}/leaveRequests/{reqId} {
      allow read: if sameOrg(orgId) || canReadCompanyLeave();
      allow create: if sameOrg(orgId)
        && signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.empId is string
        && request.resource.data.empId.size() > 0
        && request.resource.data.empId.size() <= 80
        && (
          !userDoc().keys().hasAny(['empId'])
          || userDoc().empId == null
          || userDoc().empId == ''
          || request.resource.data.empId == userDoc().empId
        )
        && request.resource.data.status == 'pending'
        && request.resource.data.startDate is string
        && request.resource.data.startDate.size() == 10
        && request.resource.data.endDate is string
        && request.resource.data.endDate.size() == 10
        && request.resource.data.days is number
        && request.resource.data.days >= 1
        && request.resource.data.days <= 90
        && request.resource.data.days == int(request.resource.data.days)
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 1000
        && request.resource.data.empName is string
        && request.resource.data.empName.size() <= 120;
      allow update: if isDirector()
        && resource.data.status == 'pending'
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.empId == resource.data.empId
        && request.resource.data.startDate == resource.data.startDate
        && request.resource.data.endDate == resource.data.endDate
        && request.resource.data.days == resource.data.days
        && request.resource.data.reason == resource.data.reason
        && request.resource.data.uid == resource.data.uid
        && (!('rejectReason' in request.resource.data)
            || (request.resource.data.rejectReason is string
                && request.resource.data.rejectReason.size() <= 1000));
      allow delete: if false;
    }
  }
}
