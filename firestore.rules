rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function sameOrg(orgId) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().orgId == orgId;
    }

    function isDirector() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().role == 'director';
    }

    function isBroadcastMsg(data) {
      return !('type' in data) || data.type == 'broadcast';
    }

    function isDmParticipant(data) {
      return data.type == 'dm'
        && data.participants is list
        && request.auth.uid in data.participants;
    }

    function validMsgText(data) {
      return data.text is string
        && data.text.size() > 0
        && data.text.size() <= 2000;
    }

    function validDmCreate(orgId, data) {
      return data.type == 'dm'
        && data.uid == request.auth.uid
        && data.toUid is string
        && data.toUid.size() > 0
        && data.toUid != request.auth.uid
        && data.threadId is string
        && data.threadId.size() > 0
        && data.participants is list
        && data.participants.size() == 2
        && request.auth.uid in data.participants
        && data.toUid in data.participants
        && exists(/databases/$(database)/documents/users/$(data.toUid))
        && get(/databases/$(database)/documents/users/$(data.toUid)).data.orgId == orgId;
    }

    function validBroadcastCreate(data) {
      return data.type == 'broadcast'
        && data.uid == request.auth.uid
        && isDirector();
    }

    function validProfileAge(age) {
      return age == null || (age is int && age >= 1 && age <= 150);
    }

    function validSelfProfileUpdate() {
      let diff = request.resource.data.diff(resource.data).affectedKeys();
      return diff.hasOnly(['displayName', 'age', 'updatedAt'])
        && (!diff.hasAny(['displayName'])
            || (request.resource.data.displayName is string
                && request.resource.data.displayName.size() <= 100))
        && (!diff.hasAny(['age']) || validProfileAge(request.resource.data.age))
        && request.resource.data.role == resource.data.role
        && request.resource.data.username == resource.data.username
        && request.resource.data.orgId == resource.data.orgId
        && request.resource.data.empId == resource.data.empId;
    }

    function validSelfFcmUpdate() {
      return request.resource.data.role == resource.data.role
        && request.resource.data.username == resource.data.username
        && request.resource.data.orgId == resource.data.orgId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmToken', 'empId', 'updatedAt']);
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId
        && (!request.resource.data.keys().hasAny(['role'])
            || request.resource.data.role == 'employee');
      allow update: if signedIn() && request.auth.uid == userId
        && (validSelfProfileUpdate() || validSelfFcmUpdate());
    }

    match /workspaces/{orgId}/data/{docId} {
      allow read: if sameOrg(orgId);
      allow write: if sameOrg(orgId) && isDirector();
    }

    match /workspaces/{orgId}/messages/{msgId} {
      allow read: if sameOrg(orgId)
        && (isBroadcastMsg(resource.data) || isDmParticipant(resource.data));
      allow create: if sameOrg(orgId)
        && validMsgText(request.resource.data)
        && (validDmCreate(orgId, request.resource.data) || validBroadcastCreate(request.resource.data));
      allow update, delete: if false;
    }

    match /workspaces/{orgId}/reports/{reportId} {
      allow read: if sameOrg(orgId);
      allow create, update, delete: if false;
    }
  }
}
